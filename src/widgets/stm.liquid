{% comment %} 
Real-time STM bus schedule 
{% endcomment %}

{% capture widgetId %}widget-stm-{% uuid %}{% endcapture %}

<div id="{{widgetId}}" class="widget widget-stm {{ stm.extra_classes }}">
    
</div>

<script>
    initWidgetStm(
        document.getElementById("{{widgetId}}"),
        {{ stm.stop_ids | json }},
        {{ stm.num_buses_to_show | default: 5 }},
        {{ stm.max_minutes_to_show | default: 120 }},
        "{{ stm.time_format | default: "h:mm PP" }}"
    );
    {% unless stm.is_subsequent_instance %}
        async function initWidgetStm(widget, stopIds, numBuses, maxMinutes, timeFormat) {
            const params = new URLSearchParams();
            params.append("numBuses", numBuses);
            params.append("maxMinutes", maxMinutes);
            params.append("timeFormat", timeFormat);
            for (const stopId of stopIds) {
                params.append("stopIds", stopId);
            }
            try {
                const queryString = params.toString();
                const response = await fetch(`/data/stm?${queryString}`);

                if (!response.ok) {
                    throw new Error(`HTTP error: ${response.status}`);
                }

                const data = await response.json();
                console.log(data);
                renderMetroStatus(data.metroStatuses);
                renderStops(data.busStops);

            } catch(error){
                console.error(error);
            }

            function renderMetroStatus(metroData) {
                const listEl = document.createElement("ul");
                listEl.classList.add("widget-stm__metros");

                let notOkayEl = null;

                metroData.forEach((metro)=>{
                    const listItemEl = document.createElement("li");
                    listItemEl.classList.add("widget-stm__metro-line");
                    listItemEl.style.setProperty("--metro-color", "#" + metro.line.route_color);
                    listItemEl.style.setProperty("--metro-text-color", "#" + metro.line.route_text_color);
                    listItemEl.dataset.ok = metro.ok;
                    listItemEl.innerHTML = `
                        <span class="widget-stm__metro-name">${metro.line.route_color_name}</span>
                        <span class="widget-stm__metro-message">${metro.description}</span>
                    `;
                    listEl.appendChild(listItemEl);
                    
                    if (!metro.ok) {
                        if (!notOkayEl) {
                            notOkayEl = document.createElement("div");
                            notOkayEl.classList.add("widget-stm__metro-alerts");
                        }
                        const newNotOkay = document.createElement("div");
                        newNotOkay.classList.add("widget-stm__metro-alert");
                        newNotOkay.style.setProperty("--metro-color", "#" + metro.line.route_color);
                        newNotOkay.style.setProperty("--metro-text-color", "#" + metro.line.route_text_color);
                        newNotOkay.innerHTML = `
                            <span class="widget-stm__metro-alert-line">${metro.line.route_color_name}</span>
                            <span class="widget-stm__metro-alert-message">${metro.description}</span>
                        `;
                        notOkayEl.appendChild(newNotOkay);
                    }
                });

                widget.appendChild(listEl);
                if (notOkayEl) widget.appendChild(notOkayEl);
            }

            function renderStops(busStopsData) {
                const listEl = document.createElement("ul");
                listEl.classList.add("widget-stm__stops");

                for (const stopData of busStopsData) {
                    const listItemEl = createListItemForStop(stopData);
                    listEl.appendChild(listItemEl);
                }

                widget.appendChild(listEl);
            }

            function createListItemForStop(stopData) {
                let listItemEl = document.createElement("li");
                listItemEl.classList.add("widget-stm__stop");
                listItemEl.innerHTML = `
                    <div class="widget-stm__stop-label">
                        <span class="widget-stm__stop-name">${stopData.name}</span>
                        <span class="widget-stm__stop-code">${stopData.stopId}</span>
                    </div>
                    ${stopData.alerts ? alertsHtmlString(stopData.alerts) : ""}
                    ${Object.keys(stopData.buses).length > 0 ? busesHtmlString(stopData.buses) : ""}
                `;
                return listItemEl;
            }

            function alertsHtmlString(alertsData) {
                let result = "<ul class='widget-stm__stop-alerts'>"

                for (const alertData of alertsData) {
                    result += `
                        <li class="widget-stm__stop-alert">
                            ${alertData.description}
                        </li>
                    `;
                }

                result += "</ul>"

                return result;
            }

            function busesHtmlString(busesData) {
                let result = "<ul class='widget-stm__buses'>"

                for (const bus of Object.values(busesData)) {
                    let busItem = `
                        <li class="widget-stm__bus"
                            style="--bus-color:#${bus.route_color}; --bus-text-color:#${bus.route_text_color}">
                            <div class="widget-stm__bus-heading">
                                <span class="widget-stm__bus-heading-route">${bus.route}</span>
                                <span class="widget-wtm__bus-heading-direction">${bus.direction}</span>
                            </div>
                    `;

                    if (bus.times.length > 0) busItem += busTimesHtmlString(bus.times);

                    busItem += "</li>";
                    result += busItem;
                }

                result += "</ul>";
                return result;
            }

            function busTimesHtmlString(timesData) {
                let result = "<ul class='widget-stm__bus-times'>";
                    for (const busTime of timesData) {
                        result += `
                            <li class="widget-stm__bus-time">
                                <span class="widget-stm__bus-time-abs">${busTime.time}</span>
                                <span class="widget-stm__bus-time-rel">${displayMinutes(busTime.minutesUntil)}</span>
                            </li>
                        `;
                    }

                result += "</ul>";
                return result;
            }

            function displayMinutes(minutes) {
                const hours = Math.trunc(minutes / 60);
                const newMinutes = minutes % 60;

                // let hoursString = "";
                // if (hours > 1) hoursString = `${hours} hours `;
                // else if (hours == 1) hoursString = `${hours} hour `;

                const hoursString = hours ? `${hours}hr ` : "";

                // const minutesString = (newMinutes == 1 ? `${newMinutes} minute` : `${newMinutes} minutes`);
                const minutesString = `${newMinutes}min`;

                return "in " + hoursString + minutesString;
            }
        }
    {% endunless %}
</script>