{% comment %} 
Real-time STM bus schedule 
{% endcomment %}

{% capture widgetId %}widget-stm-{% uuid %}{% endcapture %}

<div id="{{widgetId}}" class="widget widget-stm {{ stm.extra_classes }}">
    
</div>

<script>
    initWidgetStm(
        document.getElementById("{{widgetId}}"),
        {{ stm.stop_ids | json }},
        {{ stm.num_buses_to_show | default: 5 }},
        {{ stm.max_minutes_to_show | default: 120 }},
        "{{ stm.time_format | default: "h:mm PP" }}"
    );
    {% unless stm.is_subsequent_instance %}
        async function initWidgetStm(widget, stopIds, numBuses, maxMinutes, timeFormat) {
            const params = new URLSearchParams();
            params.append("numBuses", numBuses);
            params.append("maxMinutes", maxMinutes);
            params.append("timeFormat", timeFormat);
            for (const stopId of stopIds) {
                params.append("stopIds", stopId);
            }
            try {
                const queryString = params.toString();
                const response = await fetch(`/data/stm?${queryString}`);

                if (!response.ok) {
                    throw new Error(`HTTP error: ${response.status}`);
                }

                const data = await response.json();
                console.log(data);

            } catch(error){
                console.error(error);
            }
        }
    {% endunless %}
</script>