{% comment %}
Weather

Data from openmeteo. 

Required data:
- latitude
- longitude
{% endcomment %}

{% capture widgetId %}widget-weather-{% uuid %}{% endcapture %}

<div id="{{widgetId}}" class="widget widget-weather {{ weather.extra_classes }}">

</div>

<script>
    initWidgetWeather(
        document.getElementById("{{widgetId}}"),
        {{ weather.latitude }},
        {{ weather.longitude }}
    )
    {% unless weather.is_subsequent_instance %}
        async function initWidgetWeather(widget, latitude, longitude) {
            
            try {
                const queryString = new URLSearchParams({
                    latitude: latitude,
                    longitude: longitude,
                    current: true,
                    today: true
                }).toString();
                const response = await fetch("/data/weather");

                if (!response.ok) {
                    throw new Error(`HTTP error: ${response.status}`);
                }

                const data = await response.json();

                renderCurrentWeather(data.current, data.current_units);
                for (const dailyData of data.daily) {
                    renderDayWeather(dailyData);
                }
            } catch (error) {
                console.error("Error fetching weather data", error);
            }

            function renderCurrentWeather(data) {
                const currentWeatherEl = document.createElement("div");
                currentWeatherEl.classList.add("widget-weather__current");

                currentWeatherEl.innerHTML = `
                    <div class="widget-weather__type">
                        <span class="widget-weather__icon material-symbols-outlined">${data.weatherType.icon}</span>
                        <span class="widget-weather__description">${data.weatherType.description}</span>
                    </div>

                    <div class="widget-weather__temperature">
                        <span class="widget-weather__temperature-num">${data.temperature}</span>
                        <span class="widget-weather__temperature-unit">${data.tempUnit}</span>
                    </div>

                    <div class="widget-weather__feels-like">
                        <span class="widget-weather__temperature-label">Feels like</span>
                        <span class="widget-weather__temperature-num">${data.feelsLike}</span>
                        <span class="widget-weather__temperature-unit">${data.tempUnit}</span>
                    </div>

                    <div class="widget-weather__pressure">
                        <span class="widget-weather__pressure-num">${data.pressure}</span>
                        <span class="widget-weather__pressure-unit">${data.pressureUnit}</span>
                    </div>
                `

                widget.appendChild(currentWeatherEl);
            }

            function renderDayWeather(data) {
                const dayWeatherEl = document.createElement("div");
                dayWeatherEl.classList.add("widget-weather__day");

                if (data.label == "Today") {
                    dayWeatherEl.classList.add("widget-weather__day--today");
                }
                dayWeatherEl.innerHTML = `<span class='widget-weather__day-label'>${data.label}</span>`;

                dayWeatherEl.innerHTML += `
                    <div class="widget-weather__type">
                        <span class="widget-weather__icon material-symbols-outlined">${data.weatherType.icon}</span>
                        <span class="widget-weather__description">${data.weatherType.description}</span>
                    </div>

                    <div class="widget-weather__temperature">
                        <span class="widget-weather__temperature-min">
                            <span class="widget-weather__temperature-num">${data.tempMin}</span>
                            <span class="widget-weather__temperature-unit">${data.tempUnit}</span>
                        </span> –
                        <span class="widget-weather__temperature-max">
                            <span class="widget-weather__temperature-num">${data.tempMax}</span>
                            <span class="widget-weather__temperature-unit">${data.tempUnit}</span>
                        </span>
                    </div>

                    <div class="widget-weather__feels-like">
                        <span class="widget-weather__temperature-label">Feels like</span>
                        <span class="widget-weather__temperature-min">
                            <span class="widget-weather__temperature-num">${data.feelsLikeMin}</span>
                            <span class="widget-weather__temperature-unit">${data.tempUnit}</span>
                        </span> –
                        <span class="widget-weather__temperature-max">
                            <span class="widget-weather__temperature-num">${data.feelsLikeMax}</span>
                            <span class="widget-weather__temperature-unit">${data.tempUnit}</span>
                        </span>
                    </div>

                    <div class="widget-weather__pop">
                        <span class="widget-weather__pop-num">${data.pop}%</span>
                        <span class="widget-weather__pop-label">chance of precipitation</span>
                    </div>

                    <div class="widget-weather__uv">
                        <span class="widget-weather__uv-num">${data.uv}</span>
                        <span class="widget-weather__uv-label">UV index</span>
                    </div>
                `

                widget.appendChild(dayWeatherEl);
            }


        }
    {% endunless %}
</script>
