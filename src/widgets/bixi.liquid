{% comment %} 
Bixi availabilities

Required data:
- stations: a list of station objects
    - station_id: int (the station's id number)
    - show_bikes: bool (whether to show the number of available bikes)
    - show_ebikes: bool (whether to show the number of available ebikes)
    - show_docks: bool (whether to show the number of available docks)
    - visualize: bool (show a visualization of the station's bikes/dock status)
{% endcomment %}

{% capture widgetId %}widget-bixi-{% uuid %}{% endcapture %}

<div id="{{widgetId}}" class="widget widget-bixi {{ bixi.extra_classes }}">
    <ul class="widget-bixi__stations"></ul>
</div>

<script>
    initWidgetBixi(
        document.getElementById("{{widgetId}}"),
        {{ bixi.stations | json }}
    );

    {% unless bixi.is_subsequent_instance %}
    async function initWidgetBixi(widget, stations) {
        try {
            const response = await fetch("/data/bixi");

            if (!response.ok) {
                throw new Error(`HTTP error: ${response.status}`);
            }

            const data = await response.json();
            console.log(data);

            renderAlerts(data.alerts);
            renderStations(data.stations);
        } catch (error) {
            console.error("Error fetching bixi data", error);
        }

        function renderAlerts(alerts) {
            if (!alerts) return;

            for (const alert of alerts) {
                const alertEl = document.createElement("div");
                alertEl.classList.add("widget-bixi__alert");
                alertEl.innerText = alert.description;

                widget.appendChild(alertEl);
            }
        }

        function renderStations(stationsData) {
            for (const station of stations) {
                renderStation(station, stationsData[station.station_id]);
            }
        }

        function renderStation(stationConfig, stationData) {
            const stationsEl = widget.querySelector(".widget-bixi__stations");
            const name = stationData.name,
                  capacity = stationData.capacity,
                  bikesAvail = stationData.bikesAvail,
                  ebikesAvail = stationData.ebikesAvail,
                  bikesDisabled = stationData.bikesDisabled,
                  docksAvail = stationData.docksAvail,
                  docksDisabled = stationData.docksDisabled;

            const stationEl = document.createElement("li");
            stationEl.classList.add("widget-bixi__station");
            stationEl.innerHTML = `<span class="widget-bixi__station-name">${stationData.name}</span>`;

            if (stationConfig.visualize) {
                const stationVisEl = document.createElement("div");
                stationVisEl.classList.add("widget-bixi__station-vis");
                
                const bikesEl = visualizationSegmentElem("bikes", stationData.bikesAvail, stationData.capacity),
                      ebikesEl = visualizationSegmentElem("ebikes", stationData.ebikesAvail, stationData.capacity),
                      docksEl = visualizationSegmentElem("docks", stationData.docksAvail, stationData.capacity),
                      disabledEl = visualizationSegmentElem("disabled", stationData.bikesDisabled + stationData.docksDisabled, stationData.capacity);

                stationVisEl.appendChild(bikesEl);
                stationVisEl.appendChild(ebikesEl);
                stationVisEl.appendChild(docksEl);
                stationVisEl.appendChild(disabledEl);

                stationEl.appendChild(stationVisEl);
            }

            if (stationConfig.show_bikes || stationConfig.show_docks) {
                const stationCountsEl = document.createElement("ul");
                stationCountsEl.classList.add("widget-bixi__station-counters");

                if (stationConfig.show_bikes) {
                    const bikesEl = counterElem("bike", stationData.bikesAvail, "bikes available", "pedal_bike"),
                        ebikesEl = counterElem("ebike", stationData.ebikesAvail, "e-bikes available", "electric_bike");

                    stationCountsEl.appendChild(bikesEl);
                    stationCountsEl.appendChild(ebikesEl);
                }

                if (stationConfig.show_docks) {
                    const docksEl = counterElem("dock", stationData.docksAvail, "docks available", "bike_dock")
                    stationCountsEl.appendChild(docksEl);
                }

                stationEl.appendChild(stationCountsEl);
            }
            stationsEl.appendChild(stationEl);
        }

        function visualizationSegmentElem(type, count, capacity){
            const el = document.createElement("span");
            el.classList.add("widget-bixi__vis-segment");
            el.dataset.type = type;
            el.dataset.count = count;
            el.style.width = `${Math.round((count / capacity) * 100)}%`;

            return el;
        }

        function counterElem(type, count, labelText, icon) {
            const el = document.createElement("li");
            el.classList.add("widget-bixi__count");

            el.dataset.count = count;
            el.dataset.type = type;

            el.innerHTML = `
                <span class="widget-bixi__count-icon material-symbols-outlined">${icon}</span>
                <span class="widget-bixi__count-num">${count}</span>
                <span class="widget-bixi__count-label">${labelText}</span>
            `;

            return el;
        }
    }
    {% endunless %}
</script>

{% unless bixi.is_subsequent_instance %}
<style>
    :where(.widget-bixi) {
        --bixi-bikes: var(--color-blue);
        --bixi-ebikes: var(--color-purple);
        --bixi-docks: var(--color-gray);
        --bixi-disabled: var(--color-red);
        --bixi-occupied: var(--color-red);
        --bixi-available: var(--color-green);
        --bixi-low-num: var(--color-yellow);
        --bixi-very-low-num: var(--color-orange);

    }

    :where(.widget-bixi__station-vis) {
        display: flex;
        height: 1rem;
        width: min(100%, 20em);
    }

    :where(.widget-bixi__vis-segment) {
        height: 100%;

        &:where([data-type="bikes"]) {
            background-color: var(--bixi-bikes);
        }

        &:where([data-type="ebikes"]) {
            background-color: var(--bixi-ebikes);
        }

        &:where([data-type="docks"]) {
            background-color: var(--bixi-docks);
        }

        &:where([data-type="disabled"]) {
            background-color: var(--bixi-disabled);
        }
    }

    :where(.widget-bixi__count) {
        color: var(--bixi-available);

        &:where([data-count="0"]) {
            color: var(--bixi-occupied);
        }

        &:where([data-count="1"]) {
            color: var(--bixi-very-low-num);
        }

        &:where([data-count="2"]),
        &:where([data-count="3"]) {
            color: var(--bixi-low-num);
        }
    }
    
</style>
{% endunless %}
